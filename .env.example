# Postgres connection (Supabase or any Postgres 15+)
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Supabase project (apps/web auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# LLM provider for LLM-as-judge evaluators and the demo agent
ANTHROPIC_API_KEY="sk-ant-..."

# Base URL the SDK/demo agent send traces to
TICKMARK_INGEST_URL="http://localhost:3000/api/ingest"
TICKMARK_API_KEY="tk_live_..."
