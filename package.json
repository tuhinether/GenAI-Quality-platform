{
  "name": "tickmark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tickmark/db generate",
    "db:migrate": "pnpm --filter @tickmark/db migrate",
    "db:seed": "pnpm --filter demo-agent seed",
    "demo": "pnpm --filter demo-agent start"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0"
  }
}
